{
  "expo": {
    "name": "BreakPoint",
    "slug": "breakpoint",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "breakpoint",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "BreakPoint needs access to your videos so you can upload squat sets for analysis.",
          "cameraPermission": "BreakPoint uses the camera so you can record your squat sets.",
          "microphonePermission": "BreakPoint records audio along with your squat videos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "BreakPoint uses the microphone so coaches can dictate feedback.",
          "speechRecognitionPermission": "BreakPoint turns your spoken feedback into text."
        }
      ],
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "BreakPoint records your voice so you can speak your check-in and feedback instead of typing."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
